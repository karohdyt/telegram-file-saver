# ================= Required =================
BOT_TOKEN=

# Telegram numeric user IDs allowed to use the bot (comma separated).
# Don't know yours? Start the bot, send /id to it, put the number here and
# restart the bot.
ALLOWED_USER_IDS=

# From https://my.telegram.org -> "API development tools"
# (read by docker compose to start the local Bot API server)
# Public >>> 
# API_ID = 17349
# API_HASH = "344583e45741c457fe1862106095a5eb"

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ================= Defaults that match docker-compose.yml =================
# Address of the local Bot API server. Empty = official cloud API (20 MB limit).
TELEGRAM_API_URL=http://localhost:8081

# The API server runs in a container and reports file paths as seen INSIDE it.
# API_HOST_DIR is where that same folder lives on this server.
# Check it with:  docker volume inspect telegram-bot-api-data --format '{{ .Mountpoint }}'
API_CONTAINER_DIR=/var/lib/telegram-bot-api
API_HOST_DIR=/var/lib/docker/volumes/telegram-bot-api-data/_data

# ================= Optional =================
# Default folder for saved files (each user can change theirs with /path)
DEFAULT_SAVE_PATH=/root/savedfile

# Space that must stay free after saving a file
MIN_FREE_MB=200

# Restrict users to one base folder (they can then just type "movies").
# Empty = users may pick any folder except system folders.
# SAVE_ROOT=/root/savedfile

# Largest accepted file in MB (default 2000 with the local server)
# MAX_FILE_MB=2000

# HTTP read timeout in seconds - big files need time to download (default 1800)
# REQUEST_TIMEOUT=1800

# Where per-user settings are stored (default: settings.json next to bot.py)
# SETTINGS_FILE=/opt/telegram-file-saver-bot/settings.json
